# App
APP_ENV=development
APP_SECRET_KEY=change-this-to-a-random-64-char-string
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=sqlite:///./ferwafa.db

# JWT
JWT_SECRET_KEY=change-this-to-a-different-random-64-char-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Field-level encryption (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FIELD_ENCRYPTION_KEY=change-this-generated-fernet-key

# Email (SMTP)
EMAIL_SMTP_SERVER=mail.nexventures.net
EMAIL_SMTP_PORT=587
EMAIL_SENDER_EMAIL=security@nexventures.net
EMAIL_SENDER_PASSWORD=your-password-here
EMAIL_LOGIN=security@nexventures.net

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id

# Redis (rate limiting + caching + Celery broker)
REDIS_URL=redis://localhost:6379/0


# Default SG seed account (used once by scripts/seed_sg.py)
SEED_SG_NAME=Secretary General
SEED_SG_EMAIL=sg-email
SEED_SG_PASSWORD=ChangeMeImmediately123!